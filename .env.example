# Optional: public URL of a custom domain or GitHub Pages deployment.
NEXT_PUBLIC_SITE_URL=https://gentang.github.io/

# Optional: set only when the site is hosted under a repository subpath.
NEXT_PUBLIC_BASE_PATH=

# Giscus comments. Install https://github.com/apps/giscus on the repository,
# then copy the category name and ID generated by https://giscus.app/zh-CN.
NEXT_PUBLIC_GISCUS_CATEGORY=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
