{
  "name": "xiaopang-notes",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "content:generate": "node scripts/generate-content.mjs",
    "dev": "node scripts/dev-server.mjs",
    "build": "node scripts/generate-content.mjs && next build --webpack && node scripts/prepare-export.mjs",
    "preview": "node scripts/serve-static.mjs",
    "lint": "node scripts/generate-content.mjs && eslint .",
    "medium:stage": "node scripts/medium-import-control.mjs stage",
    "medium:status": "node scripts/medium-import-control.mjs status",
    "medium:remove": "node scripts/medium-import-control.mjs remove",
    "test:medium-import": "node --test tests/medium-import.test.mjs",
    "test": "node scripts/check-site.mjs",
    "publish:local": "node scripts/check-site.mjs --lint"
  },
  "dependencies": {
    "katex": "0.18.1",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@mathjax/src": "4.0.0",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "rehype-stringify": "10.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "sharp": "0.34.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0"
  },
  "type": "module"
}
